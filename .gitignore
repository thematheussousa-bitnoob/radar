# THE SECRET. Not negotiable.
#
# `plow-credentials` carries PLOW_AGENT_TOKEN -- the agent's badge. Whoever has
# this file speaks for the line. Everyone who installs mints their own with
# `plow-agents mint`; none ships with the repository.
plow-credentials
plow-credentials.*
!plow-credentials.example

# Build and runtime leftovers.
__pycache__/
*.pyc
.pytest_cache/

# ---------------------------------------------------------------------------
# THE HOUSE -- not product.
